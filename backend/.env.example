# BFAT v2 - Copy to backend/.env (or project root .env). NEVER commit .env
# Real $ in account? Set BINANCE_TESTNET=false

# Auth (required for login - single admin)
APP_USERNAME=
APP_PASSWORD=
JWT_SECRET=change-me-in-production

# Binance Futures (required for engine & equity display)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_TESTNET=true  = testnet (separate sandbox). false = mainnet (real funds)
BINANCE_TESTNET=true
BFAT_SYMBOL=BTCUSDT

# Database
DATABASE_URL=sqlite:///./bfat.db

# Optional
LOG_LEVEL=INFO
