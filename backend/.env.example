# Binance API (never commit real keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Futures Base URL
# Production: https://fapi.binance.com
# Testnet: https://testnet.binancefuture.com
FAPI_BASE_URL=https://testnet.binancefuture.com

# WebSocket Base (optional, derived from FAPI_BASE_URL if not set)
# Production: wss://fstream.binance.com
# Testnet: wss://stream.binancefuture.com
WS_BASE_URL=

# App config (for Windows Standalone: use relative or APPDATA paths)
# Config file path; empty = ./config/autopilot.json relative to backend root
CONFIG_DIR=
