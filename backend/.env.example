# BFAT v2 - Copy to backend/.env (or project root .env). NEVER commit .env
# Real $ in account? Set BINANCE_TESTNET=false

# Auth (required for login - single admin)
APP_USERNAME=
APP_PASSWORD=
JWT_SECRET=change-me-in-production

# Binance Futures (required for engine & equity display)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_TESTNET=true  = testnet (separate sandbox). false = mainnet (real funds)
BINANCE_TESTNET=true
BFAT_SYMBOL=BTCUSDT
# Optional multi-symbol scanner. Leave blank to use BFAT_SYMBOL only.
# Example: BFAT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BFAT_SYMBOLS=
BFAT_MAX_CONCURRENT_POSITIONS=2

# Database
DATABASE_URL=sqlite:///./bfat.db

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Optional
LOG_LEVEL=INFO
